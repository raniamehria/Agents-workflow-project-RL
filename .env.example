# GCP Configuration
# Copy this file to `.env` and fill in your own values.

# Your GCP project ID (find it in the GCP Console)
GCP_PROJECT_ID=agentics-workflows-2

# The GCP region you will be using (e.g. eu, europe-west2, us-central1)
GCP_REGION=europe-west2

# GCS bucket location (multi-region is fine for storage only)
GCS_LOCATION=eu

# The name of a GCS bucket you have created
GCP_BUCKET_NAME=lmr-llmops

PIPELINE_ROOT=gs://lmr-llmops/pipeline_root
RAW_DATASET_URI=gs://lmr-llmops/yoda_sentences.csv
